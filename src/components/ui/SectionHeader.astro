---
interface Props {
  eyebrow?: string;
  heading: string;
  subheading?: string;
  centered?: boolean;
  class?: string;
  /** Override the eyebrow colour where pink-dark lacks contrast — e.g. on a
      pink-light section, where it only reaches 3.59:1 against the 4.5:1 AA bar. */
  eyebrowClass?: string;
}

const {
  eyebrow,
  heading,
  subheading,
  centered = false,
  class: className = '',
  eyebrowClass = 'text-pink-dark',
} = Astro.props;
---

<div class={`${centered ? 'text-center' : ''} ${className}`}>
  {eyebrow && (
    <p class={`mb-3 text-xs font-medium uppercase tracking-widest ${eyebrowClass}`}>
      {eyebrow}
    </p>
  )}
  <h2 class="font-display text-4xl font-semibold text-charcoal sm:text-5xl">
    {heading}
  </h2>
  {subheading && (
    <p class={`mt-4 text-lg text-charcoal-mid leading-relaxed max-w-2xl ${centered ? 'mx-auto' : ''}`}>
      {subheading}
    </p>
  )}
  <!-- Decorative underline -->
  <div class={`mt-5 h-0.5 w-12 bg-pink ${centered ? 'mx-auto' : ''}`} />
</div>
