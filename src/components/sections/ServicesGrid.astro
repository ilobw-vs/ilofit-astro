---
import SectionHeader from '../ui/SectionHeader.astro';

const c = {
  eyebrow: 'Miten voin auttaa sinua?',
  heading: 'Palvelut ja hinnat',
  // `price` is optional — cards without it just show the "Lue lisää" link
  services: [
    {
      label: 'Yksilövalmennus – Ole.Fit Manhattan',
      description: 'Henkilökohtainen valmennus Ole.Fit Manhattanin salilla. Räätälöity ohjelma ja jatkuva tuki.',
      href: '/palvelut/yksilovalmennus#hinnat',
      price: '75 €/kk',
      cta: 'Hinnat ja sisältö',
    },
    {
      label: 'Yksilövalmennus – asiakkaan tiloissa',
      description: 'Tulen luoksesi – treenataan kotona, työpaikalla tai ulkona. Ei salijäsenyyttä.',
      href: '/palvelut/yksilovalmennus-asiakkaan-tiloissa',
    },
    {
      label: 'Pienryhmävalmennus',
      description: 'Energistä ryhmätreeniä Turun alueella enintään 10 hengen porukassa. Motivaatiota ryhmästä + yksilöllistä huomiota.',
      href: '/palvelut/pienryhmavalmennus',
    },
    {
      label: 'Ulkotreenit',
      description: 'Monipuolista treeniä kehonpainolla ja välineillä raittiissa ilmassa Turun alueella. Sopii kaikille kuntotasoille.',
      href: '/palvelut/ulkotreenit',
    },
    {
      label: 'Yrityspalvelut',
      description: 'Tyky-päivät, taukojumpat ja treenit yrityksen henkilöstölle. Hyvinvoiva henkilöstö on yrityksen voimavara.',
      href: '/palvelut/yrityspalvelut',
    },
    {
      label: 'Treenimatkat',
      description: 'Aktiivinen hyvinvointiloma samanhenkisessä seurassa — sopivasti treeniä, rentoutumista ja elämyksiä.',
      href: '/palvelut/treenimatkat',
    },
    {
      label: 'Treeniohjelmat',
      description: 'Yksilöllisesti räätälöity treeniohjelma kattavan taustatietolomakkeen ja haastattelun pohjalta.',
      href: '/palvelut/treeniohjelma',
    },
  ],
};

const iconMap: Record<string, string> = {
  '/palvelut/yksilovalmennus': `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
  '/palvelut/yksilovalmennus-asiakkaan-tiloissa': `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
  '/palvelut/pienryhmavalmennus': `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  '/palvelut/ulkotreenit': `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>`,
  '/palvelut/yrityspalvelut': `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`,
  '/palvelut/treenimatkat': `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
  '/palvelut/treeniohjelma': `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`,
};
---

<section id="palvelut_taulukko" class="bg-off-white py-24 lg:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <SectionHeader
        eyebrow={c.eyebrow}
        heading={c.heading}
        centered
      />
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {c.services.map((service: { href: string; label: string; description: string; price?: string; cta?: string }) => (
        <a
          href={service.href}
          class="card-accent group relative flex flex-col rounded-xl border border-soft-border bg-white p-6 shadow-warm transition-all duration-300 hover:shadow-warm-md hover:-translate-y-1"
        >
          <div class="mb-4 w-11 h-11 rounded-lg bg-pink-light flex items-center justify-center transition-colors group-hover:bg-pink text-pink-dark group-hover:text-white">
            <Fragment set:html={iconMap[service.href.split('#')[0]] ?? iconMap['/palvelut/yksilovalmennus']} />
          </div>
          <h3 class="font-display text-xl font-semibold text-charcoal mb-2">
            {service.label}
          </h3>
          <p class="text-sm text-charcoal-mid leading-relaxed mb-4">
            {service.description}
          </p>
          {/* mt-auto pins this to the card bottom, so every "Lue lisää" lines up
              across the row whether or not the card shows a price */}
          <div class="mt-auto">
            {service.price && (
              <p class="mb-3 text-sm text-charcoal-mid">
                alkaen <span class="font-semibold text-charcoal">{service.price}</span>
                <span class="text-xs whitespace-nowrap"> (sis. alv)</span>
              </p>
            )}
            {service.cta ? (
              /* Styled as a span, not a Button — the whole card is already an
                 <a>, and nesting interactive elements is invalid HTML.
                 Matches Button.astro's `ghost` variant. */
              <span class="inline-flex items-center justify-center gap-2 rounded-lg border border-[1.5px] border-pink px-4 py-2 text-xs font-medium text-charcoal transition-all duration-200 group-hover:bg-pink-light">
                {service.cta} →
              </span>
            ) : (
              <span class="text-xs font-medium text-pink transition-colors group-hover:text-pink-dark">
                Lue lisää →
              </span>
            )}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
