---
import SectionHeader from '../ui/SectionHeader.astro';

const c = {
  eyebrow: 'Tavoitteet',
  heading: 'Mitkä ovat sinun tavoitteesi?',
  // Osoittivat aiemmin /palvelut/yksilovalmennus-sivulle. Se on
  // väliaikaisesti piilotettu navigaatiosta sivuston uudistuksen ajaksi,
  // joten tavoitteet ohjataan kuukausivalmennukseen.
  goals: [
    { label: 'Painonpudotus', href: '/palvelut/yksilovalmennus-asiakkaan-tiloissa' },
    { label: 'Kiinteytyminen', href: '/palvelut/yksilovalmennus-asiakkaan-tiloissa' },
    { label: 'Lihasmassan kasvatus', href: '/palvelut/yksilovalmennus-asiakkaan-tiloissa' },
    { label: 'Elämäntapamuutos', href: '/palvelut/yksilovalmennus-asiakkaan-tiloissa' },
    { label: 'Arjen energisyys', href: '/palvelut/yksilovalmennus-asiakkaan-tiloissa' },
    { label: 'Kehonhuolto', href: '/palvelut/yksilovalmennus-asiakkaan-tiloissa' },
    { label: 'Yritystreeni', href: '/palvelut/yrityspalvelut' },
    { label: 'Ryhmäliikunta', href: '/palvelut/pienryhmavalmennus' },
    { label: 'Ulkotreenit', href: '/palvelut/ulkotreenit' },
  ],
};
---

<section class="bg-white py-24">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
    <SectionHeader
      eyebrow={c.eyebrow}
      heading={c.heading}
      centered
      class="mb-12"
    />
    <div class="flex flex-wrap justify-center gap-3">
      {c.goals.map((goal: { label: string; href: string }) => (
        <a
          href={goal.href}
          class="rounded-full border border-soft-border bg-off-white px-5 py-2.5 text-sm font-medium text-charcoal-mid transition-all duration-200 hover:border-pink hover:bg-pink-light hover:text-charcoal"
        >
          {goal.label}
        </a>
      ))}
    </div>
  </div>
</section>
