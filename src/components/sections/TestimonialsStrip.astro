---
import SectionHeader from '../ui/SectionHeader.astro';

interface Review {
  author: string;
  service: string;
  text: string;
  rating: number;
}

const c: { eyebrow: string; heading: string; reviews: Review[] } = {
  eyebrow: 'Asiakaskokemuksia',
  heading: 'Mitä asiakkaat sanovat',
  reviews: [
    {
      author: 'Maria K.',
      text: 'Ehdottomasti yks viikon kohokohdista! Vaihtuvat, tehokkaat liikkeet - Ilonan treenit on ihan parasta',
      service: 'Ulkotreenit',
      rating: 5,
    },
    {
      author: 'Sanna L.',
      text: 'Saliharjoitteluni on Ilonan tekemillä ohjelmilla selvästi monipuolistunut. Aiemmin treenini on painottunut ylävartaloon, mutta nyt mukaan on tullut tehokkaita jalka- ja keskivartaloliikkeitä, jotka tukevat lajiharjoittelua.',
      service: 'Treeniohjelmat',
      rating: 5,
    },
    {
      author: 'Asiakas',
      text: 'Ilonan yksilövalmennus muutti suhtautumistani treeniin ja uskon että nämä oivallukset kantavat pitkälle tulevaisuuteen. Sain juuri minulle sopivan, monipuolisen treeniohjelman niin sisä- kuin ulkotreeneihin sekä parannusvinkkejä ruokavalioon. Olen ihan yllättynyt miten uskalsin haastaa itseäni fiksusti, ja olenkin alkanut nähdä tuloksia jo muutamassa viikossa. Oli todella kivaa harjoitella Ilonan kanssa - suosittelen lämpimästi!',
      service: 'Yksilövalmennus',
      rating: 5,
    },
    {
      author: 'Heidi',
      text: 'Ilonan kuntosalivalmennus oli loistava ponnahduslauta aloittaa salitreenit n. 20v tauon jälkeen uudelleen. Opastus liikkeiden oikeaoppisessa tekniikassa sekä monipuoliset kuntosaliohjelmat ovat luoneet varmuutta tekemiseen. Eipä olisi tullut treenattua omatoimisesti kuin vyötäröstä ylöspäin, kun polvien kanssa on ollut haasteita. Ilona otti tämän hyvin huomioon ja löytyi sopivat liikkeet, jotka vahvistavat mm. niveliä ympäröiviä lihaksia. Siellä mä nyt kyykkään vailla nivelkipuja!\n\nInspiroiva ja kannustava valmennus, suosittelen lämpimästi!\n',
      service: 'Yksilövalmennus',
      rating: 5,
    },
    {
      author: 'Asiakas',
      text: 'Kiitos kovasti taas eilisestä! Tuntuu kamalan hyvältä! Tämä lihaskipu on koukuttavaa.',
      service: 'Ulkotreenit',
      rating: 5,
    },
    {
      author: 'Asiakas',
      text: 'Ihana treenata ulkona porukalla! Monipuolista ja helppoa hikiliikuntaa',
      service: 'Ulkotreenit',
      rating: 5,
    },
    {
      author: 'Asiakas',
      text: 'Huh, mikä ohjelma! Ihan huippu ja nyt mentiin sitten ihan uudelle levelille, kiitos! Hiki pinnassa täällä ihan eri tavalla, oli mukavasti haastetta. Palaan asiaan, kun tarvitsen taas päivitystä muutaman kuukauden päästä!',
      service: 'Treeniohjelmat',
      rating: 5,
    },
  ],
};

const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "IloFit",
  "@id": "https://ilofit.com",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": (c.reviews.reduce((sum: number, r: Review) => sum + r.rating, 0) / c.reviews.length).toFixed(1),
    "reviewCount": c.reviews.length,
    "bestRating": 5,
    "worstRating": 1,
  },
  "review": c.reviews.map((r: Review) => ({
    "@type": "Review",
    "author": { "@type": "Person", "name": r.author },
    "reviewRating": { "@type": "Rating", "ratingValue": r.rating, "bestRating": 5 },
    "reviewBody": r.text,
    "name": r.service,
  })),
};

const starSvg = `<svg width="14" height="14" viewBox="0 0 24 24" fill="#E8A0B0" stroke="#E8A0B0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`;
---

<script type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />

<section id="kokemuksia" class="bg-pink-light py-24 lg:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      {/* charcoal-mid, not pink-dark: this section is bg-pink-light, where
          pink-dark only reaches 3.59:1 */}
      <SectionHeader
        eyebrow={c.eyebrow}
        heading={c.heading}
        eyebrowClass="text-charcoal-mid"
        centered
      />
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {c.reviews.map((r: Review) => (
        <div class="rounded-xl bg-white p-8 shadow-warm">
          <div class="flex gap-0.5 mb-4">
            {[...Array(r.rating)].map(() => (
              <Fragment set:html={starSvg} />
            ))}
          </div>
          <blockquote class="text-charcoal-mid leading-relaxed text-sm mb-6 italic">
            &ldquo;{r.text}&rdquo;
          </blockquote>
          <div>
            <p class="text-xs text-pink-dark mt-0.5">{r.service}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
