---
import SectionHeader from '../ui/SectionHeader.astro';

const c = {
  eyebrow: 'Sertifioitu Personal Trainer',
  heading: 'Hei, olen Ilona',
  image: '/images/ilona.webp',
  paragraphs: [
    'Olen 48-vuotias helposti lähestyttävä, positiivinen ja kannustava Personal Trainer Turusta. ',
    'Olen aina liikkunut aktiivisesti ja nuorempana harrastanut muun muassa joukkuevoimistelua, josta kipinä liikuntaan ja terveellisiin elämäntapoihin jäikin sitten loppuiäksi.',
    'Haluan auttaa ihmisiä voimaan kokonaisvaltaisesti hyvin ilman liikaa tiukkapipoisuutta. Kahden lapsen äitinä minulle on erityisen tuttua perhe-elämän ja työn yhteensovittamisen haasteet ruuhkavuosien ja arjen kiireessä, jolloin helposti laiminlyödään omaa hyvinvointia. On kuitenkin paljon tapoja lisätä liikuntaa ja terveyttä edistäviä tekoja jokaiseen päivään, kunhan käyttää vähän luovuutta ja suunnitelmallisuutta! Kyse ei ole vain fyysisestä vahvuudesta, vaan kokonaisvaltaisesta hyvinvoinnista ja tasapainosta arkeen rennolla ja järkevällä otteella. Valmennan lempeän jämäkästi – kuunnellen, kannustaen ja sopivasti haastaen.  ',
    'Tykkään ohjata etenkin toiminnallisia treenejä, niin sisällä kuin ulkona ja pitää harjoitukset mahdollisimman monipuolisina ja hauskoina.  Omat harrastukseni painottuvat tällä hetkellä kuntosaliharjoitteluun ja padeliin. Lisäksi viihdyn luonnossa liikkuen ja tykkään joogata, mikä tuo hyvää vastapainoa kiireiseen arkeen.',
  ],
};
---

<section id="ilona" class="bg-white py-24 lg:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-16 lg:grid-cols-2 lg:gap-24 items-center">

      <!-- Photo (hidden on mobile) -->
      <div class="relative hidden lg:block">
        <div class="relative aspect-[4/5] max-w-md mx-auto lg:mx-0 overflow-hidden rounded-2xl shadow-warm-md">
          <img
            src={c.image}
            alt="Ilona Salomäki — Personal Trainer Turku"
            class="w-full h-full object-cover"
          />
        </div>
        <!-- Decorative pink accents -->
        <div class="absolute -bottom-4 -right-4 w-32 h-32 rounded-full bg-pink-light opacity-60 -z-10"></div>
        <div class="absolute -top-4 -left-4 w-20 h-20 rounded-full bg-pink/20 -z-10"></div>
      </div>

      <!-- Text -->
      <div>
        <SectionHeader
          eyebrow={c.eyebrow}
          heading={c.heading}
          class="mb-6"
        />
        {c.paragraphs.map((p: string) => (
          <p class="text-charcoal-mid leading-relaxed text-md mb-6">{p}</p>
        ))}
      </div>
    </div>
  </div>
</section>
