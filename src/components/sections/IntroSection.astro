---
import SectionHeader from '../ui/SectionHeader.astro';

const c = {
  eyebrow: 'Sertifioitu Personal Trainer',
  heading: 'Hei, olen Ilona',
  image: '/images/ilona.webp',
  paragraphs: [
    'Olen Ilona, 48-vuotias personal trainer Turusta. Valmennan erityisesti 40+ naisia, jotka haluavat aloittaa treenaamisen tai saada lisää tehoa harjoitteluun – oli tavoitteena painonpudotus, lihaskunto tai parempi jaksaminen arjessa.',
    'Tiedän itsekin, millaista on sovittaa treeni ruuhkavuosien arkeen. Kahden lapsen äitinä työn ja perheen yhteensovittaminen on tuttua – ja se, miten helposti oma hyvinvointi jää viimeiseksi. Olen samassa elämänvaiheessa kuin moni valmennettavani, ja tiedän omasta kokemuksesta, että keho toimii neljänkympin jälkeen eri tavalla kuin kaksikymppisenä, ja myös esivaihdevuosien tuomat muutokset ovat tulleet minulle tutuksi.',
    'Juuri siksi treeni pitää rakentaa tähän ikään sopivaksi. Lihasmassan ylläpito, luuston vahvistaminen ja riittävä palautuminen ovat tärkeämpiä kuin koskaan. Suunnittelen ohjelman, joka sopii sinun arkeesi, kuntotasoosi ja tavoitteisiisi sekä olen tukena matkalla kohti tavoitteitasi.',
    'Valmennan lempeän jämäkästi – kuunnellen, kannustaen ja sopivasti haastaen. Ilman tiukkapipoisuutta ja ilman pikadieettejä.',
    'Liikunta on ollut osa elämääni lapsuudesta asti ja kilpavoimistelutaustani on luonut vahvan pohjan kehonhallinnalle ja liiketekniikalle. Nykyään kuntosaliharjoittelu, padel, jooga ja luonnossa liikkuminen pitävät minut hyvässä kunnossa.',
  ],

  // Sits after the story on purpose: the paragraphs earn the trust, this block
  // backs it up. Also the one part of the intro a first-time visitor scans for,
  // so it stays in the text column — the photo column is hidden on mobile.
  credentials_heading: 'Koulutus',
  credentials: [
    { title: 'Personal trainer', provider: 'Trainer4You', year: '2019' },
    { title: 'Toiminnallisen harjoittelun ohjaaja', provider: 'Spartan', year: '2021' },
    { title: 'Mobility Coach', provider: 'Spartan', year: '2021' },
    { title: 'Kahvakuulaohjaaja', provider: 'Spartan', year: '2022' },
    { title: 'Ikääntyneiden VOITAS voima- ja tasapainoharjoitteluvalmentaja', provider: 'Turun kaupunki', year: '2025' },
  ],
};
---

<section id="ilona" class="bg-white py-24 lg:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-16 lg:grid-cols-2 lg:gap-24 items-center">

      <!-- Photo (hidden on mobile) -->
      <div class="relative hidden lg:block">
        <div class="relative aspect-[4/5] max-w-md mx-auto lg:mx-0 overflow-hidden rounded-2xl shadow-warm-md">
          <img
            src={c.image}
            alt="Ilona Salomäki — Personal Trainer Turku"
            class="w-full h-full object-cover"
          />
        </div>
        <!-- Decorative pink accents -->
        <div class="absolute -bottom-4 -right-4 w-32 h-32 rounded-full bg-pink-light opacity-60 -z-10"></div>
        <div class="absolute -top-4 -left-4 w-20 h-20 rounded-full bg-pink/20 -z-10"></div>
      </div>

      <!-- Text -->
      <div>
        <SectionHeader
          eyebrow={c.eyebrow}
          heading={c.heading}
          class="mb-6"
        />
        {c.paragraphs.map((p: string) => (
          <p class="text-charcoal-mid leading-relaxed text-md mb-6">{p}</p>
        ))}

        <div class="mt-10 rounded-xl border border-soft-border bg-off-white p-6">
          <p class="text-xs font-medium uppercase tracking-widest text-pink-dark mb-4">{c.credentials_heading}</p>
          <ul class="space-y-3">
            {c.credentials.map((item) => (
              <li>
                {/* Title on its own line — the VOITAS one is long enough to wrap
                    badly if the provider sits beside it */}
                <p class="text-sm font-medium text-charcoal leading-snug">{item.title}</p>
                <p class="text-xs text-charcoal-mid mt-0.5">{item.provider} · {item.year}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
