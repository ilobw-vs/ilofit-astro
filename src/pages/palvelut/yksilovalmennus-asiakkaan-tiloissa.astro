---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Button from '../../components/ui/Button.astro';

const c = {
  hero_eyebrow: 'Yksilövalmennus',
  hero_heading: 'Yksilövalmennus – Asiakkaan tiloissa tai ulkona',
  hero_text1: 'Tulen sinun luoksesi. Treenataan kotonasi, työpaikan tiloissa tai ulkokuntosalilla.',
  hero_text2: 'Sama henkilökohtainen ohjaus ja räätälöity ohjelma kuin salivalmennuksessa, mutta sinulle sopivassa paikassa ja sinun aikataulullasi.',
  hero_cta_primary: 'Varaa ilmainen konsultaatio',
  hero_image: '/images/ulkotreenit-hero.webp',

  prices_heading: 'Hinnat – Asiakkaan tiloissa tai ulkokuntosalilla',
  prices_vat: 'Kaikki hinnat sisältävät arvonlisäveron.',
  price_groups: [
    {
      heading: 'Kuukausisopimukset',
      note: 'Minimi 3 kuukautta. Hinnat toistaiseksi voimassa 1kk irtisanomisajalla.',
      rows: [
        { label: '60 min valmennus kerran kuukaudessa', price: '75 €/kk' },
        { label: '60 min valmennus 2 kertaa kuukaudessa', price: '140 €/kk' },
        { label: '60 min valmennus 4 kertaa kuukaudessa', price: '270 €/kk' },
      ],
      included: 'Sisältää treeniohjelman ja ruokavalion, mahdolliset muutokset niihin, sekä valmentajan jatkuvan tuen.',
    },
    {
      heading: 'Valmennuspaketit',
      note: 'Valmennuspaketit voimassa 3 kuukautta aloituksesta.',
      rows: [
        { label: '5 kerran valmennus', price: '70 €/kerta (350 €)' },
        { label: '10 kerran valmennuspaketti', price: '68 €/kerta (680 €)' },
      ],
      included: 'Sisältää treeniohjelman ja ruokavalion, mahdolliset muutokset niihin, sekä valmentajan jatkuvan tuen.',
    },
    {
      heading: 'Kertavalmennus',
      price: '80 €',
      included: 'Ei sisällä treeniohjelmaa eikä ruokavaliota.',
    },
    {
      heading: 'Treeniohjelma ja valmennus',
      price: '99 €',
      included: 'Sisältää 60 min valmennuksen, ei sisällä ruokavaliota.',
    },
  ],


  suitable_eyebrow: 'Kenelle sopii',
  suitable_heading: 'Kenelle tämä sopii?',
  suitable: [
    {
      title: 'Kiireiseen arkeen',
      desc: 'Ei matkaa salille eikä pukuhuonejonoja. Treeni mahtuu työpäivän lomaan tai lasten päiväunien ajaksi.',
    },
    {
      title: 'Aloittelijalle',
      desc: 'Salin kynnys voi tuntua korkealta. Tutussa ympäristössä on helpompi aloittaa omaan tahtiin.',
    },
    {
      title: 'Ulkoilmasta nauttivalle',
      desc: 'Raikas ilma ja vaihtuvat maisemat tuovat treeniin vaihtelua – säällä kuin säällä.',
    },
    {
      title: 'Työpaikoille',
      desc: 'Tulen yrityksenne tiloihin. Sopii myös pienelle porukalle tai yksittäiselle työntekijälle.',
    },
  ],

  cta_eyebrow: 'Aloitetaan',
  cta_heading: 'Valmis aloittamaan?',
  cta_text: 'Ilmainen alkukartoitus on maksuton ja sitoumukseton. Kerro missä haluaisit treenata, niin katsotaan mikä sopii sinulle parhaiten.',
  cta_button: 'Varaa ilmainen konsultaatio',
};

// Kuukausisopimukset renders on its own; everything else shares the left card
const [monthlyGroup, ...otherGroups] = c.price_groups;

---

<PageLayout
  title="Yksilövalmennus kotona tai ulkona | IloFit — Personal Trainer Turku"
  description="Personal trainer tulee luoksesi Turun alueella. Yksilövalmennusta kotona, työpaikalla tai ulkona – ilman salijäsenyyttä. Varaa ilmainen alkukartoitus."
>

  <section class="bg-off-white pt-36 pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-xs font-medium uppercase tracking-widest text-pink-dark mb-3">{c.hero_eyebrow}</p>
          <h1 class="font-display text-5xl font-semibold text-charcoal sm:text-6xl mb-6">{c.hero_heading}</h1>
          <p class="text-xl text-charcoal-mid max-w-xl leading-relaxed mb-8">{c.hero_text1}</p>
          <p class="text-xl text-charcoal-mid max-w-xl leading-relaxed mb-8">{c.hero_text2}</p>
          <div class="flex flex-col items-start gap-3">
            <Button href="/varaa?palvelu=yksilovalmennus-asiakkaan-tiloissa" size="lg">{c.hero_cta_primary}</Button>
          </div>
        </div>
        <div class="relative">
          <div class="w-full h-[420px] rounded-3xl overflow-hidden shadow-warm">
            <img src={c.hero_image} alt="Yksilövalmennusta ulkona Turussa – IloFit" class="w-full h-full object-cover object-center grayscale" />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* scroll-mt clears the fixed 80px navbar when linked to via #hinnat */}
  <section id="hinnat" class="scroll-mt-24 bg-white py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

      <SectionHeader heading={c.prices_heading} class="mb-4" />

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">

        {/* Left: monthly contracts — primary offering, carries the CTA */}
        <div class="rounded-2xl border border-soft-border bg-off-white p-8">
          <p class="text-charcoal text-lg font-semibold mb-2">{monthlyGroup.heading}</p>
          {monthlyGroup.note && <p class="text-charcoal-mid text-sm mb-4">{monthlyGroup.note}</p>}
          <div class="space-y-3">
            {monthlyGroup.rows.map((row) => (
              <div class="flex flex-col gap-1 rounded-xl border border-soft-border bg-white p-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                <span class="text-sm font-medium text-charcoal">{row.label}</span>
                <span class="shrink-0 font-semibold text-pink-dark">{row.price}</span>
              </div>
            ))}
          </div>
          {monthlyGroup.included && <p class="text-charcoal-mid text-sm mt-3 leading-relaxed">{monthlyGroup.included}</p>}
          {monthlyGroup.footnote && <p class="text-charcoal-mid/70 text-xs mt-2">{monthlyGroup.footnote}</p>}

          <p class="text-charcoal-mid text-sm py-8">{c.prices_vat}</p>

          <div class="mb-8 rounded-xl border border-pink/30 p-4 max-w-md">
            <p class="text-charcoal-mid text-sm mb-2">Huom: myös liikuntaedut käyvät!</p>
            <div class="mt-2 flex flex-wrap gap-2">
              <span class="rounded-full bg-pink-light px-3 py-1 text-xs font-medium text-charcoal">Smartum</span>
              <span class="rounded-full bg-pink-light px-3 py-1 text-xs font-medium text-charcoal">E-passi</span>
              <span class="rounded-full bg-pink-light px-3 py-1 text-xs font-medium text-charcoal">Edenred</span>
            </div>
          </div>

          <div class="mt-8">
            <Button href="/varaa?palvelu=yksilovalmennus-asiakkaan-tiloissa" class="w-full justify-center">Tee varaus tästä</Button>
          </div>
        </div>

        {/* Right: packages and one-off prices */}
        <div class="rounded-2xl border border-soft-border bg-off-white p-8">
          <div class="space-y-10">
            {otherGroups.map((g) => (
              <div>
                <p class="text-charcoal text-lg font-semibold mb-2">{g.heading}</p>
                {g.note && <p class="text-charcoal-mid text-sm mb-4">{g.note}</p>}
                {g.rows && (
                  <div class="space-y-3">
                    {g.rows.map((row) => (
                      <div class="flex flex-col gap-1 rounded-xl border border-soft-border bg-white p-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                        <span class="text-sm font-medium text-charcoal">{row.label}</span>
                        <span class="shrink-0 font-semibold text-pink-dark">{row.price}</span>
                      </div>
                    ))}
                  </div>
                )}
                {g.price && (
                  <div class="rounded-xl border border-soft-border bg-white p-4">
                    <span class="font-semibold text-pink-dark">{g.price}</span>
                  </div>
                )}
                {g.included && <p class="text-charcoal-mid text-sm mt-3 leading-relaxed">{g.included}</p>}
                {g.footnote && <p class="text-charcoal-mid/70 text-xs mt-2">{g.footnote}</p>}
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="bg-off-white py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <SectionHeader eyebrow={c.suitable_eyebrow} heading={c.suitable_heading} centered />
      </div>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {c.suitable.map((item) => (
          <div class="card-accent rounded-xl border border-soft-border bg-white p-6 shadow-warm">
            <h3 class="font-display text-xl font-semibold text-charcoal mb-3">{item.title}</h3>
            <p class="text-sm text-charcoal-mid leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
      <SectionHeader eyebrow={c.cta_eyebrow} heading={c.cta_heading} centered class="mb-6" />
      <p class="text-charcoal-mid mb-8">{c.cta_text}</p>
      <Button href="/varaa?palvelu=yksilovalmennus-asiakkaan-tiloissa" size="lg">{c.cta_button}</Button>
    </div>
  </section>

</PageLayout>
