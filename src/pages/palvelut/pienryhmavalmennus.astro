---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Button from '../../components/ui/Button.astro';

const c = {
  hero_eyebrow: 'Palvelut',
  hero_heading: 'Ryhmävalmennus',
  hero_text: 'Ryhmässä saat yksilöllistä ohjausta ja pääset haastamaan itsesi. Opit oikeat ja turvalliset liiketekniikat sekä tehokkaimmat liikkeet. Saat lisämotivaatiota treenaamiseen sekä kannustusta omien treenitavoitteiden saavuttamiseen.',
  hero_cta: 'Varaa paikka',
  hero_image: '/images/small_groups.webp',

  // Ryhmät listataan tässä järjestyksessä: kahvakuula, bootcamp, ulkotreenit.
  groups_cta: 'Kysy vapaista paikoista',

  kettlebell_heading: 'Kahvakuularyhmä',
  kettlebell_time: 'Tiistaisin klo 19-20, Syvälahdentie 31, Turku',

  bootcamp_heading: 'Bootcamp-ryhmä',
  bootcamp_desc: 'Näissä toiminnallisissa treeneissä treenataan lihaskuntoa ja voimaa modernissa ja privaatissa studioympäristössä, josta löytyvät monipuoliset vapaapainot sekä treenivälineet tehokkaaseen ja laadukkaaseen treeniin.',
  bootcamp_time1: 'Sunnuntaisin, Mojo, Ilpoistentie 16 a, Turku',
  bootcamp_time2: 'Ryhmä 1 klo 18-19',
  bootcamp_time3: 'Ryhmä 2 klo 19-20',

  // Ulkotreeneillä on oma sivunsa ja oma varausjärjestelmänsä, joten tässä
  // riittää lyhyt maininta ja sama varausnappi kuin ulkotreenit-sivulla.
  outdoor_heading: 'Ulkotreenit',
  outdoor_text: 'Ulkotreenit Syvälahdessa Hirvensalossa.',
  outdoor_cta: 'Lisätiedot ja Varaus',
  outdoor_href: 'https://ilofit.as.me',

  benefits_heading: 'Ryhmävalmennuksen edut',
  benefits: [
    'Ryhmän energia ja motivaatio nostaa suoritusta',
    'Edullisempi kuin yksilövalmennus',
    'Hyvä tapa treenata kaverin kanssa',
    'Monipuolinen ja vaihtelevainen treeni',
    'Sopii kaikille kuntotasoille',
  ],

  cta_eyebrow: 'Aloitetaan',
  cta_heading: 'Haluatko mukaan ryhmään?',
  cta_button: 'Kysy vapaista paikoista',
};

const checkSvg = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E8A0B0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-0.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`;
---

<PageLayout title="Pienryhmävalmennus Turku | IloFit — Personal Trainer" description="Ryhmävalmennusta Turussa: kahvakuula, bootcamp ja ulkotreenit ammattivalmentajan ohjauksessa. Energinen ryhmätreeni kaikille kuntotasoille.">

  <section class="bg-off-white pt-36 pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-xs font-medium uppercase tracking-widest text-pink-dark mb-3">{c.hero_eyebrow}</p>
          <h1 class="font-display text-5xl font-semibold text-charcoal sm:text-6xl mb-6">{c.hero_heading}</h1>
          <p class="text-xl text-charcoal-mid max-w-xl leading-relaxed mb-8">{c.hero_text}</p>
          <Button href="/yhteystiedot?palvelu=pienryhmavalmennus" size="lg">{c.hero_cta}</Button>
        </div>
        <div class="relative">
          <div class="w-full h-[420px] rounded-3xl overflow-hidden shadow-warm">
            <img src={c.hero_image} alt="Ryhmävalmennus Turussa – IloFit" class="w-full h-full object-cover object-center grayscale" />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* scroll-mt clears the fixed 80px navbar when linked to via #hinnat */}
  <section id="hinnat" class="scroll-mt-24 bg-white py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div class="rounded-2xl border border-soft-border bg-off-white p-8">
          <SectionHeader heading="Ryhmät ja ajat" class="mb-8" />

          <div class="rounded-xl border border-pink/30 p-4 mb-10">
            <p class="text-charcoal-mid text-sm mb-2">Huom: myös liikuntaedut käyvät!</p>
            <div class="mt-2 flex flex-wrap gap-2">
              <span class="rounded-full bg-pink-light px-3 py-1 text-xs font-medium text-charcoal">Smartum</span>
              <span class="rounded-full bg-pink-light px-3 py-1 text-xs font-medium text-charcoal">E-passi</span>
              <span class="rounded-full bg-pink-light px-3 py-1 text-xs font-medium text-charcoal">Edenred</span>
            </div>
          </div>

          <p class="text-charcoal-mid text-lg font-semibold mb-3">{c.kettlebell_heading}</p>
          <p class="text-charcoal-mid text-sm mb-6">{c.kettlebell_time}</p>
          <div class="mt-4">
            <Button href="/yhteystiedot?palvelu=pienryhmavalmennus" class="w-full justify-center">{c.groups_cta}</Button>
          </div>

          <p class="text-charcoal-mid text-lg font-semibold mt-12 mb-3">{c.bootcamp_heading}</p>
          <p class="text-charcoal-mid text-sm mb-3">{c.bootcamp_desc}</p>
          <p class="text-charcoal-mid text-sm mb-1">{c.bootcamp_time1}</p>
          <p class="text-charcoal-mid text-sm mb-1">{c.bootcamp_time2}</p>
          <p class="text-charcoal-mid text-sm mb-6">{c.bootcamp_time3}</p>
          <div class="mt-4">
            <Button href="/yhteystiedot?palvelu=pienryhmavalmennus" class="w-full justify-center">{c.groups_cta}</Button>
          </div>

          <p class="text-charcoal-mid text-lg font-semibold mt-12 mb-3">{c.outdoor_heading}</p>
          <p class="text-charcoal-mid text-sm mb-6">{c.outdoor_text}</p>
          <div class="mt-4">
            <Button href={c.outdoor_href} external class="w-full justify-center">{c.outdoor_cta}</Button>
          </div>

        </div>

        <div class="rounded-2xl border border-soft-border bg-white p-8">
          <SectionHeader heading={c.benefits_heading} class="mb-8" />
          <ul class="space-y-4">
            {c.benefits.map((b) => (
              <li class="flex items-start gap-3">
                <Fragment set:html={checkSvg} />
                <span class="text-charcoal-mid">{b}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-off-white py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
      <SectionHeader eyebrow={c.cta_eyebrow} heading={c.cta_heading} centered class="mb-6" />
      <Button href="/yhteystiedot?palvelu=pienryhmavalmennus" size="lg">{c.cta_button}</Button>
    </div>
  </section>

</PageLayout>
