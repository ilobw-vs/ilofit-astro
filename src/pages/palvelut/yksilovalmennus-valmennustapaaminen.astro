---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Button from '../../components/ui/Button.astro';

const c = {
  hero_eyebrow: 'IloFit valmennustapaaminen',
  hero_heading: 'Valmennustapaaminen',
  hero_text1: 'Tulen sinun luoksesi. Treenataan kotonasi, työpaikan tiloissa tai ulkokuntosalilla.',
  hero_text2: 'Ohjattu valmennustapaaminen sinulle sopivassa paikassa ja sinun aikataulullasi.',
  hero_cta_primary: 'Varaa ilmainen konsultaatio',
  hero_image: '/images/ulkotreenit-hero.webp',

  prices_heading: 'Hinnat ja sisältö',
  prices_vat: 'Kickstart paketti on voimassa 3 kuukautta tilauksesta. Kaikki hinnat sisältävät arvonlisäveron.',
  price_groups: [
    {
      heading: 'IloFit valmennustapaaminen',
      rows: [
        { label: 'Valmennustapaaminen', price: '85 €/kerta' },
      ],
    },
    {
      heading: 'Kickstart paketti - 5 valmennustapaamista',
      note: 'Valmennuspaketit voimassa 3 kuukautta aloituksesta.',
      rows: [
        { label: '5 valmennustapaamista', price: '70 €/kerta (350 €)' },
      ],
    },
    {
      heading: 'Treeniohjelma',
      price: '50 €',
    },
  ],

  price_groups2: [
     {
      rows: [
        { label: 'Kickstart - 5 valmennustapaamista', price: '70 €/kerta (350 €)' },
      ],
    },
  ],

  included_heading: 'Valmennustapaaminen sisältää',
  included: [
    'Ohjattu tapaaminen valitussa paikassa',
    'Mahdolliset parannusehdotukset nykyiseen treeniohjelmaasi',
    'Halutessasi suoritustekniikoiden sekä laitteiden ja välineiden oikeaoppisen käytön harjoittelu.',
    'Muut sovitut asiat',
  ],

  cta_eyebrow: 'Aloitetaan',
  cta_heading: 'Valmis aloittamaan?',
  cta_button: 'Varaa ilmainen konsultaatio',
};

// Kuukausisopimukset renders on its own; everything else shares the left card
const [monthlyGroup, ...otherGroups] = c.price_groups;
const [monthlyGroup2] = c.price_groups2;

const checkSvg = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#E8A0B0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-1"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`;


---

<PageLayout
  title="Yksilövalmennus kotona tai ulkona | IloFit — Personal Trainer Turku"
  description="Personal trainer tulee luoksesi Turun alueella. Yksilövalmennusta kotona, työpaikalla tai ulkona – ilman salijäsenyyttä. Varaa ilmainen alkukartoitus."
>

  <section class="bg-off-white pt-36 pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-xs font-medium uppercase tracking-widest text-pink-dark mb-3">{c.hero_eyebrow}</p>
          <h1 class="font-display text-5xl font-semibold text-charcoal sm:text-6xl mb-6">{c.hero_heading}</h1>
          <p class="text-xl text-charcoal-mid max-w-xl leading-relaxed mb-8">{c.hero_text1}</p>
          <p class="text-xl text-charcoal-mid max-w-xl leading-relaxed mb-8">{c.hero_text2}</p>
        </div>
        <div class="relative">
          <div class="w-full h-[420px] rounded-3xl overflow-hidden shadow-warm">
            <img src={c.hero_image} alt="Yksilövalmennusta ulkona Turussa – IloFit" class="w-full h-full object-cover object-center grayscale" />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* scroll-mt clears the fixed 80px navbar when linked to via #hinnat */}
  <section id="hinnat" class="scroll-mt-24 bg-white py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

      <SectionHeader heading={c.prices_heading} class="mb-4" />

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">

        {/* Left: monthly contracts — primary offering, carries the CTA */}
        <div class="rounded-2xl border border-soft-border bg-off-white p-8">
          <p class="text-charcoal text-lg font-semibold mb-2">{monthlyGroup.heading}</p>
          {monthlyGroup.note && <p class="text-charcoal-mid text-sm mb-4">{monthlyGroup.note}</p>}
          <div class="space-y-3">
            {monthlyGroup.rows.map((row) => (
              <div class="flex flex-col gap-1 rounded-xl border border-soft-border bg-white p-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                <span class="text-sm font-medium text-charcoal">{row.label}</span>
                <span class="shrink-0 font-semibold text-pink-dark">{row.price}</span>
              </div>
            ))}
          </div>

          <div class="space-y-3 py-8">
            {monthlyGroup2.rows.map((row2) => (
              <div class="flex flex-col gap-1 rounded-xl border border-soft-border bg-white p-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                <span class="text-sm font-medium text-charcoal">{row2.label}</span>
                <span class="shrink-0 font-semibold text-pink-dark">{row2.price}</span>
              </div>
            ))}
          </div>

          {monthlyGroup.included && <p class="text-charcoal-mid text-sm mt-3 leading-relaxed">{monthlyGroup.included}</p>}
          {monthlyGroup.footnote && <p class="text-charcoal-mid/70 text-xs mt-2">{monthlyGroup.footnote}</p>}

          <p class="text-charcoal-mid text-sm py-8">{c.prices_vat}</p>

          <div class="mb-8 rounded-xl border border-pink/30 p-4 max-w-md">
            <p class="text-charcoal-mid text-sm mb-2">Huom: myös liikuntaedut käyvät!</p>
            <div class="mt-2 flex flex-wrap gap-2">
              <span class="rounded-full bg-pink-light px-3 py-1 text-xs font-medium text-charcoal">Smartum</span>
              <span class="rounded-full bg-pink-light px-3 py-1 text-xs font-medium text-charcoal">E-passi</span>
              <span class="rounded-full bg-pink-light px-3 py-1 text-xs font-medium text-charcoal">Edenred</span>
            </div>
          </div>

          <div class="mt-8">
            <Button href="/varaa?palvelu=ilofit-valmennustapaaminen" class="w-full justify-center">Tee varaus tästä</Button>
          </div>
        </div>

        <!-- Sisältää -->
        <div class="rounded-2xl border border-soft-border bg-white p-8">
          <SectionHeader heading={c.included_heading} class="mb-8" />
          <ul class="space-y-4">
            {c.included.map((item) => (
              <li class="flex items-start gap-3">
                <Fragment set:html={checkSvg} />
                <span class="text-charcoal-mid">{item}</span>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </section>

</PageLayout>
