---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Button from '../../components/ui/Button.astro';

const c = {
  hero_eyebrow: 'Yksilövalmennus',
  hero_heading: 'Yksilövalmennus – Ole.Fit Manhattan',
  hero_text1: 'Treenataan yhdessä Ole.Fit Manhattanin tiloissa, salin koko laitteisto ja vapaat painot käytössäsi.',
  hero_text2: 'Olipa kyseessä sitten painonpudotus, kiinteytys, lihasvoiman kasvatus tai yleinen terveyden edistys, teemme suunnitelman tavoitteen saavuttamiseksi ja olen tukenasi koko valmennuksen ajan.',
  hero_cta_primary: 'Varaa ilmainen konsultaatio',
  hero_image: '/images/skanssi-9717.webp',

  prices_heading: 'Hinnat – Ole.Fit Manhattan',
  prices_vat: 'Kaikki hinnat sisältävät arvonlisäveron.',
  /* Each group renders: heading, optional note, rows (or a single price),
     an optional "sisältää" line and an optional footnote. */
  price_groups: [
    {
      heading: 'Kuukausisopimukset',
      rows: [
        { label: '1 tapaaminen kuukaudessa (sisältää 10 tapaamista)', price: 'alkaen* 72 €/kk' },
        { label: '2 tapaamista kuukaudessa (sisältää 20 tapaamista)', price: 'alkaen* 138 €/kk' },
        { label: '3 tapaamista kuukaudessa (sisältää 30 tapaamista)', price: 'alkaen* 200 €/kk' },
        { label: '4 tapaamista kuukaudessa (sisältää 40 tapaamista)', price: 'alkaen* 250 €/kk' },
      ],
      included: 'Sisältää treeniohjelman ja ruokavalion, mahdolliset muutokset niihin, sekä valmentajan jatkuvan tuen.',
      footnote: '*Alkaen-hinta perustuu 12 maksuerään.',
    },
    {
      heading: 'Valmennuspaketit',
      rows: [
        { label: 'Kickstart, 5 tapaamisen valmennuspaketti', price: 'alkaen* 94 €/kk' },
      ],
      included: 'Sisältää treeniohjelman ja ruokavalion, mahdolliset muutokset niihin, sekä valmentajan jatkuvan tuen.',
      footnote: '*Alkaen-hinta perustuu 5 maksuerään.',
    },
    {
      heading: 'Kertatapaaminen',
      price: '90 €',
      included: 'Ei sisällä treeniohjelmaa eikä ruokavaliota.',
    },
    {
      heading: 'Treeniohjelma',
      price: '119 €',
      included: 'Sisältää ohjauksen, ei sisällä ruokavaliota.',
    },
  ],


  goals_eyebrow: 'Kenelle sopii',
  goals_heading: 'Mihin tavoitteisiin?',
  goals: [
    {
      title: 'Painonpudotus',
      desc: 'Tehokas ja kestävä painonpudotus oikean harjoittelun ja ravinto-ohjauksen avulla. Ei pikadieettejä — pysyviä elämäntapamuutoksia.',
    },
    {
      title: 'Kiinteytyminen',
      desc: 'Kiinteä ja sporttinen kroppa kehon koostumusta parantamalla. Yhdistetään sopiva lihaskuntoharjoittelu sekä cardio.',
    },
    {
      title: 'Lihasmassan kasvatus',
      desc: 'Progressiivinen harjoittelu, joka rakentaa lihasta tehokkaasti ja turvallisesti.',
    },
    {
      title: 'Elämäntapamuutos',
      desc: 'Liikunnasta pysyvä osa arkeasi. Löydät liikunnan ilon ja rakennat terveet, kestävät rutiinit.',
    },
  ],

  cta_eyebrow: 'Aloitetaan',
  cta_heading: 'Valmis aloittamaan?',
  cta_text: 'Ilmainen alkukartoitus on maksuton ja sitoumukseton. Otetaan ensimmäinen askel yhdessä.',
  cta_button: 'Varaa ilmainen konsultaatio',
};

// Kuukausisopimukset renders on its own; everything else shares the left card
const [monthlyGroup, ...otherGroups] = c.price_groups;

---

<PageLayout title="Yksilövalmennus Ole.Fit Manhattan | IloFit — Personal Trainer Turku" description="Henkilökohtainen yksilövalmennus Ole.Fit Manhattanin salilla Turussa. Räätälöity treeniohjelma ja jatkuva tuki. Varaa ilmainen alkukartoitus.">

  <section class="bg-off-white pt-36 pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-xs font-medium uppercase tracking-widest text-pink-dark mb-3">{c.hero_eyebrow}</p>
          <h1 class="font-display text-5xl font-semibold text-charcoal sm:text-6xl mb-6">{c.hero_heading}</h1>
          <p class="text-xl text-charcoal-mid max-w-xl leading-relaxed mb-8">{c.hero_text1}</p>
          <p class="text-xl text-charcoal-mid max-w-xl leading-relaxed mb-8">{c.hero_text2}</p>
          <div class="flex flex-col items-start gap-3">
            <Button href="/varaa?palvelu=yksilovalmennus" size="lg">{c.hero_cta_primary}</Button>
          </div>
        </div>
        <div class="relative">
          <div class="w-full h-[420px] rounded-3xl overflow-hidden shadow-warm">
            <img src={c.hero_image} alt="Yksilövalmennus Turussa – IloFit" class="w-full h-full object-cover object-top grayscale" />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* scroll-mt clears the fixed 80px navbar when linked to via #hinnat */}
  <section id="hinnat" class="scroll-mt-24 bg-white py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

      <SectionHeader heading={c.prices_heading} class="mb-4" />
      <p class="text-charcoal-mid text-sm mb-8">{c.prices_vat}</p>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">

        {/* Left: monthly contracts — primary offering, carries the CTA */}
        <div class="rounded-2xl border border-soft-border bg-off-white p-8">
          <p class="text-charcoal text-lg font-semibold mb-2">{monthlyGroup.heading}</p>
          {monthlyGroup.note && <p class="text-charcoal-mid text-sm mb-4">{monthlyGroup.note}</p>}
          <div class="space-y-3">
            {monthlyGroup.rows.map((row) => (
              <div class="flex flex-col gap-1 rounded-xl border border-soft-border bg-white p-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                <span class="text-sm font-medium text-charcoal">{row.label}</span>
                <span class="shrink-0 font-semibold text-pink-dark">{row.price}</span>
              </div>
            ))}
          </div>
          {monthlyGroup.included && <p class="text-charcoal-mid text-sm mt-3 leading-relaxed">{monthlyGroup.included}</p>}
          {monthlyGroup.footnote && <p class="text-charcoal-mid/70 text-xs mt-2">{monthlyGroup.footnote}</p>}

          <div class="mt-8">
            <Button href="/varaa?palvelu=yksilovalmennus" class="w-full justify-center">Kysy lisää tai varaa aika</Button>
          </div>
        </div>

        {/* Right: packages and one-off prices */}
        <div class="rounded-2xl border border-soft-border bg-off-white p-8">
          <div class="space-y-10">
            {otherGroups.map((g) => (
              <div>
                <p class="text-charcoal text-lg font-semibold mb-2">{g.heading}</p>
                {g.note && <p class="text-charcoal-mid text-sm mb-4">{g.note}</p>}
                {g.rows && (
                  <div class="space-y-3">
                    {g.rows.map((row) => (
                      <div class="flex flex-col gap-1 rounded-xl border border-soft-border bg-white p-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                        <span class="text-sm font-medium text-charcoal">{row.label}</span>
                        <span class="shrink-0 font-semibold text-pink-dark">{row.price}</span>
                      </div>
                    ))}
                  </div>
                )}
                {g.price && (
                  <div class="rounded-xl border border-soft-border bg-white p-4">
                    <span class="font-semibold text-pink-dark">{g.price}</span>
                  </div>
                )}
                {g.included && <p class="text-charcoal-mid text-sm mt-3 leading-relaxed">{g.included}</p>}
                {g.footnote && <p class="text-charcoal-mid/70 text-xs mt-2">{g.footnote}</p>}
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="bg-off-white py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <SectionHeader eyebrow={c.goals_eyebrow} heading={c.goals_heading} centered />
      </div>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {c.goals.map((goal) => (
          <div class="card-accent rounded-xl border border-soft-border bg-white p-6 shadow-warm">
            <h3 class="font-display text-xl font-semibold text-charcoal mb-3">{goal.title}</h3>
            <p class="text-sm text-charcoal-mid leading-relaxed">{goal.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <section class="bg-white py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
      <SectionHeader eyebrow={c.cta_eyebrow} heading={c.cta_heading} centered class="mb-6" />
      <p class="text-charcoal-mid mb-8">{c.cta_text}</p>
      <Button href="/varaa?palvelu=yksilovalmennus" size="lg">{c.cta_button}</Button>
    </div>
  </section>

</PageLayout>
